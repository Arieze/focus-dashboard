{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Dashboard",
  "version": "0.8.0",
  "identifier": "fr.personalos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus Dashboard",
        "width": 850,
        "height": 1200,
        "minWidth": 440,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Votre espace personnel, local et indépendant",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
